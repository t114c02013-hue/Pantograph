# Unity generated
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
# Logs：追蹤段落紀錄與報告，只排除備份與 Unity 自動產生的 log
/[Ll]ogs/backup-*.zip
/[Ll]ogs/*.log
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
# Recordings：只是不追蹤，檔案不可刪除、不可移動
/[Rr]ecordings/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio / Rider / VS Code
.vs/
.idea/
.vscode/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Gradle cache
.gradle/

# Burst / Addressables generated
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*
*_BurstDebugInformation_DoNotShip/

# OS
.DS_Store
Thumbs.db

# 編輯器狀態探針（每秒改寫）
/[Ll]ogs/editor-state.txt

# Python 快取（含絕對路徑，會自動重建）
__pycache__/
*.pyc
/Tools/Blender/**/__pycache__/

# R1.5b 分批交付的原始檔（terry 放的，不提交）
/R1.5b-inbox/

# GitHub Unity 範本補齊
/[Ee]xported[Oo]bj/
.consulo/
crashlytics-build.properties
/[Aa]ssets/[Ss]treamingAssets/aa*
# 測試驅動的請求和結果（每次跑都變）
/Logs/rec-check.txt
/Logs/rec-check.request
