  - text: "\u6263\u56DE\u5E73\u53F0\u639B\u9EDE\u3001\u89E3\u958B\u8ECA\u9802\u639B\u9EDE\uFF0C\u4E0B\u8ECA\u9802"
    why: 
    targetId: "ip.depot.platform_anchor;ip.roof.anchor;tool.safety_harness\uFF08\u80F8\u524D\u6263\u74B0\uFF09"
    toolId: tool.safety_harness
    condition: player.zone=platform&&harness.hooks_stowed
