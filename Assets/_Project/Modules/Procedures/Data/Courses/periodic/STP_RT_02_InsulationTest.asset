  - text: "\u628A\u6E05\u6F54\u5E03\u6536\u56DE\u5DE5\u5177\u888B\u4E26\u518D\u6E05\u9EDE\u4E00\u6B21"
    why: 
    targetId: env.tool_rack.slot_8;env.tool_bag
    toolId: tool.cleaning_cloth
    condition: rack.slot_5=on_rack&&rack.slot_6=on_rack&&rack.slot_7=on_rack&&rack.slot_8=on_rack&&rack.slot_9=on_rack&&rack.slot_10=on_rack&&rack.slot_13=on_rack&&roof.leftover_count<=0
    standPointId: tp.roof.base_e.s
    subId: r3g
    textDesktop: 
    hint: "\u53F3\u624B\u628A\u6E05\u6F54\u5E03\u79FB\u56DE\u5DE6\u8170\u7684\u5DE5\u5177\u888B\uFF0C\u653E\u958B\u63E1\u628A\u5C31\u6536\u56DE\u3002"
