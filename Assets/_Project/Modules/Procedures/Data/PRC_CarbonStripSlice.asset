  title: "\u96C6\u96FB\u5F13\u78B3\u6ED1\u677F\u66F4\u63DB\uFF08\u5207\u7247\uFF09"
  goal: "\u5B8C\u6210\u5B89\u5168\u9694\u96E2\u5F8C\uFF0C\u91CF\u6E2C\u5169\u689D\u78B3\u6ED1\u677F\u539A\u5EA6\u4E26\u5224\u5B9A\uFF1B\u9700\u8981\u66F4\u63DB\u6642\u4F9D\u5E8F\u62C6\u4E0B\u3001\u6E05\u6F54\u3001\u6AA2\u67E5\u65B0\u54C1\u3001\u5B89\u88DD\u3001\u9396\u5230\u898F\u5B9A\u626D\u529B\u4E26\u6A19\u8A18\uFF0C\u6700\u5F8C\u6536\u5C3E\u89E3\u9664\u63A5\u5730\u3002"
  safetyPoints:
  - "\u78B0\u5F13\u9AD4\u524D\u5FC5\u9808\uFF1A\u7528\u5347\u964D\u63A7\u5236\u5668\u964D\u5230\u964D\u5F13\u4F4D\u7F6E\u4E26\u89AA\u773C\u78BA\u8A8D\u3001\u4E0A\u9396\u639B\u724C\u3001\u65B7\u5347\u5F13\u96FB\u6E90\u3001\u9A57\u96FB\uFF08\u5148\u81EA\u6AA2\uFF09\u3001\u63A5\u5730\uFF08\u7AEF\u5B50
    \u2192 \u62C9\u7DDA\u78BA\u8A8D \u2192 \u5F13\u982D\uFF09\u3002"
  - "\u63A5\u5730\u62C6\u9664\u9806\u5E8F\u76F8\u53CD\uFF1A\u5148\u62C6\u5F13\u982D\u7AEF\uFF0C\u518D\u62C6\u5E73\u53F0\u7AEF\u5B50\u3002"
  - "\u4EFB\u4E00\u689D\u4E09\u9EDE\u6700\u5C0F\u503C \u2264 3.0 mm\uFF08\u4FDD\u990A\u8868\u503C\uFF09\u5C31\u5169\u689D\u4E00\u8D77\u63DB\uFF0C\u4E0D\u80FD\u53EA\u63DB\u4E00\u689D\u3002"
  - "\u65B0\u6ED1\u677F\u659C\u9762\u671D\u5916\uFF0C\u626D\u529B 25 N\xB7m\uFF08\u793A\u4F8B\u503C\uFF09\uFF0C\u4F9D
    1\u21922\u21923\u21924 \u9806\u5E8F\u3002"
