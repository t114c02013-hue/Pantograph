  what: "\u540A\u7269\u61F8\u7A7A\u6642\uFF0C\u4F60\u8D70\u9032\u4E86\u540A\u7269\u4E0B\u65B9\u7684\u7D05\u5340\uFF0C\u5929\u8ECA\u5DF2\u505C\u6B62\u3002"
  why: "\u540A\u7269\u6216\u540A\u5177\u4E00\u65E6\u812B\u843D\u3001\u64FA\u76EA\uFF0C\u4E0B\u65B9\u7684\u4EBA\u6703\u88AB\u7838\u50B7\uFF1B\u540A\u7269\u4E0B\u65B9\u4EFB\u4F55\u6642\u5019\u90FD\u4E0D\u80FD\u6709\u4EBA\u3002"
  fix: "\u5148\u9000\u51FA\u7D05\u5340\uFF08\u540A\u7269\u6295\u5F71\u5916 1 m\uFF09\uFF0C\u518D\u91CD\u65B0\u6309\u4F4F\u6309\u9375\u64CD\u4F5C\uFF1B\u540A\u904B\u6642\u7AD9\u5728\u7D05\u5340\u5916\u770B\u8457\u540A\u7269\u3002"
