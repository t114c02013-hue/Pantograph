  toolId: tool.grounding_rod
  displayName: "\u63A5\u5730\u68D2"
  hotkey: 3
  tutorial:
    pages:
    - title: "\u7528\u9014"
      body: "\u628A\u5F13\u9AD4\u63A5\u5230\u5927\u5730\uFF0C\u842C\u4E00\u6709\u96FB\u6642\u96FB\u6D41\u8D70\u63A5\u5730\u7DDA\u800C\u4E0D\u662F\u4F60\u3002"
    - title: "\u639B\u63A5\u9806\u5E8F"
      body: "\u2460 \u9EDE\u5E73\u53F0\u63A5\u5730\u7AEF\u5B50\uFF08\u9EC3\u7DA0\uFF09\u593E\u4E0A
        \u2192 \u2461 \u6309\u4E0B\u65B9\u300C\u62C9\u7DDA\u78BA\u8A8D\u300D\u2192
        \u2462 \u9EDE\u5F13\u982D\u63A5\u5730\u639B\u9EDE\u639B\u4E0A\u3002"
    - title: "\u62C6\u9664\u9806\u5E8F"
      body: "\u548C\u639B\u63A5\u76F8\u53CD\uFF1A\u2460 \u9EDE\u5F13\u982D\u639B\u9EDE\u53D6\u4E0B
        \u2192 \u2461 \u9EDE\u5E73\u53F0\u7AEF\u5B50\u53D6\u4E0B\u3002"
    - title: "\u6CE8\u610F"
      body: "\u5148\u639B\u5F13\u982D\u3001\u6216\u5148\u62C6\u7AEF\u5B50\uFF0C\u90FD\u6703\u88AB\u7CFB\u7D71\u64CB\u4E0B\uFF0C\u56E0\u70BA\u90A3\u6642\u96FB\u6D41\u53EF\u80FD\u7D93\u904E\u4F60\u7684\u8EAB\u9AD4\u3002"
  parameters: []
