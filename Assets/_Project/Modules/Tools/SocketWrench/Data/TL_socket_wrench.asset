    - title: "\u7528\u9014"
      body: "\u9B06\u958B\u8207\u9810\u9396\u78B3\u6ED1\u677F\u56FA\u5B9A\u87BA\u6813\uFF08M8\uFF0C\u793A\u4F8B\u503C\uFF09\u3002"
    - title: "\u8A2D\u5B9A"
      body: "\u4E0B\u65B9\u9762\u677F\u9078\u5957\u7B52\u5C3A\u5BF8\uFF0810\uFF0F13\uFF0F17
        mm\uFF0C\u6B63\u78BA\u662F 13 mm\uFF09\u8207\u65B9\u5411\uFF08\u9B06\uFF0F\u9396\uFF09\u3002"
    - title: "\u65CB\u8F49"
      body: "\u9EDE\u87BA\u6813\u5957\u4E0A\u5F8C\uFF0C\u6EFE\u8F2A\u6BCF\u683C\u8F49
        45\xB0\uFF0C\u6216\u6309\u4F4F\u5DE6\u9375\u5DE6\u53F3\u62D6\u66F3\u3002\u534A\u5708\uFF1D180\xB0\u3002"
    - title: "\u53D6\u51FA\u8207\u653E\u56DE"
      body: "\u87BA\u6813\u8F49\u5230\u812B\u51FA\u5F8C\u518D\u9EDE\u4E00\u4E0B\uFF1D\u6536\u9032\u96F6\u4EF6\u76D2\u3002\u65B9\u5411\u662F\u300C\u9396\u300D\u6642\u9EDE\u7A7A\u5B54\uFF1D\u5F9E\u96F6\u4EF6\u76D2\u653E\u56DE\u87BA\u6813\u3002"
