  m_Script: {fileID: 11500000, guid: 8321b8ae7684dac4c8c3d0ee2431ce3d, type: 3}
  m_Name: TL_voltage_detector
  m_EditorClassIdentifier: 
  toolId: tool.voltage_detector
  displayName: "\u9A57\u96FB\u5668"
  hotkey: 2
  tutorial:
    pages:
    - title: "\u7528\u9014"
      body: "\u78BA\u8A8D\u5F13\u982D\u771F\u7684\u6C92\u96FB\u3002\u63A5\u5730\u524D\u4E00\u5B9A\u8981\u5148\u9A57\u96FB\u3002"
    - title: "\u7B2C\u4E00\u6B65\uFF1A\u81EA\u6AA2"
      body: "\u9EDE\u5DE5\u5177\u53F0\u4E0A\u7684\u300C\u9A57\u96FB\u5668\u81EA\u6AA2\u5668\u300D\u3002\u770B\u5230\u7DA0\u71C8\u3001\u807D\u5230\u55F6\u8072\uFF0C\u4EE3\u8868\u9A57\u96FB\u5668\u6B63\u5E38\u3002"
    - title: "\u7B2C\u4E8C\u6B65\uFF1A\u91CF\u6E2C"
      body: "\u9EDE\u5F13\u982D\u63A5\u5730\u639B\u9EDE\uFF0C\u756B\u9762\u6703\u986F\u793A\u300C\u7121\u96FB\u300D\u6216\u300C\u6709\u96FB\u300D\u3002"
    - title: "\u6CE8\u610F"
      body: "\u6C92\u81EA\u6AA2\u5C31\u91CF\uFF0C\u7D50\u679C\u4E0D\u53EF\u4FE1\uFF1A\u58DE\u6389\u7684\u9A57\u96FB\u5668\u4E5F\u6703\u986F\u793A\u7121\u96FB\u3002"
  parameters:
  - "display=\u7121\u96FB/\u6709\u96FB"
